// mnPaper version metadata (product identity for the installed exe).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    2,7,0,0
 PRODUCTVERSION 2,7,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "mnPaper"
            VALUE "FileDescription",  "mnPaper - whole-screen paper texture"
            VALUE "FileVersion",      "2.7.0"
            VALUE "InternalName",     "mnPaper"
            VALUE "LegalCopyright",   "(c) mnPaper. All rights reserved."
            VALUE "OriginalFilename", "mnPaper.exe"
            VALUE "ProductName",      "mnPaper"
            VALUE "ProductVersion",   "2.7.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
